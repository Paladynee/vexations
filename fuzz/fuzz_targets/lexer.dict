# Dictionary for lexer fuzzing
# These strings are used by libfuzzer to seed input generation

# Common symbols
"("
")"
"["
"]"
"{"
"}"
";"
","
"."
":"
"="
"+"
"-"
"*"
"/"
"%"
"&"
"|"
"^"
"~"
"!"
"?"
"<"
">"
"@"
"#"
"$"

# Whitespace patterns
" "
"\t"
"\n"
"\r"

# Numbers
"0"
"1"
"42"
"999"
"0xAB"
"0o77"
"0b11"

# Identifiers
"x"
"test"
"value"
"_private"
"CamelCase"
"snake_case"

# Operators (two-char)
"+="
"-="
"*="
"/="
"%="
"&="
"|="
"^="
"<<"
">>"
"=="
"!="
"<="
">="
"&&"
"||"
".."
"->"
"=>"

# Comments
"//"
"/*"
"*/"
"#"

# String delimiters
"\""
"'"

# Edge cases
"\x00"
"\xFF"
